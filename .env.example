# ─────────────────────────────────────────────────────────────────────────────
# Torob In-Person Shopping Agent — نمونه متغیرهای محیطی
#
#   cp .env.example .env     و مقادیر را پر کنید
#
# ⚠️ فایل .env هرگز نباید در Git ثبت شود (در .gitignore هست).
# ⚠️ هیچ کلید API در کد hard-code نشده؛ همه از اینجا خوانده می‌شوند.
# ⚠️ بدون هیچ‌کدام از کلیدهای زیر هم برنامه کامل کار می‌کند (حالت Demo).
# ─────────────────────────────────────────────────────────────────────────────

# ── برنامه ───────────────────────────────────────────────────────────────────
APP_ENV=production                 # development | production
APP_DEBUG=false
LOG_LEVEL=INFO

# پورت‌های docker compose
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ── دیتابیس ──────────────────────────────────────────────────────────────────
# پیش‌فرض برای docker compose (داخل volume مشترک /data):
DATABASE_URL=sqlite:////data/torob_agent.db
# اجرای محلی بدون Docker:
# DATABASE_URL=sqlite:///./torob_agent.db
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://torob:torob@db:5432/torob

POSTGRES_USER=torob
POSTGRES_PASSWORD=torob
POSTGRES_DB=torob

# ── دیتاست ───────────────────────────────────────────────────────────────────
# مسیر پوشه‌ای که shops.csv / products.csv / offers.csv در آن است.
# در docker compose، این پوشه هاست به /data مانت می‌شود:
DATASET_HOST_DIR=./data
DATASET_NAME=starcoach-dataset-v16-cap300-csv
IMPORT_BATCH_SIZE=10000

# مسیر داخلی (در ایمیج تنظیم می‌شود؛ معمولاً نیازی به تغییر نیست)
DATASET_DIR=/data

# ── CORS ─────────────────────────────────────────────────────────────────────
# در حالت تک‌دامنه (پروکسی Next.js) نیازی نیست؛ با * باز می‌ماند.
# در استقرار جدا-جدا، دامنه فرانت‌اند را دقیق بنویسید:
FRONTEND_ORIGINS=*
# FRONTEND_ORIGINS=https://shop.example.com

# ── پل ارتباطی فرانت → بک‌اند (فرانت‌اند می‌خواند) ─────────────────────────
# مرورگر فقط با دامنهٔ فرانت حرف می‌زند؛ route handler در
# frontend/app/api/[...path]/route.ts این متغیر را **در زمان اجرا** می‌خواند
# و /api/* را به بک‌اند فوروارد می‌کند. پس تغییر آدرس بک‌اند نیازی به rebuild
# ایمیج ندارد.
# محلی:           http://127.0.0.1:8000
# docker compose: http://backend:8000        (نام سرویس، شبکهٔ داخلی)
# لیارا:          http://<app-id>:8000       (آدرس شبکهٔ خصوصی، نه دامنهٔ عمومی)
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# ── LLM (اختیاری) ────────────────────────────────────────────────────────────
# ── مدل زبانی ایجنت ─────────────────────────────────────────────────────
# ایجنت یک حلقهٔ tool calling دارد. با کلید، مدل تصمیم می‌گیرد کدام ابزار را
# صدا بزند؛ بدون کلید، همان ابزارها با «برنامه‌ریز قطعی» اجرا می‌شوند.
# هر دو مسیر همان قرارداد پاسخ را می‌دهند، پس دمو بدون هزینه هم کار می‌کند.
LLM_PROVIDER=none                  # none | openai | openrouter | groq | ollama | anthropic
LLM_MODEL=                         # خالی = پیش‌فرض هر provider
LLM_API_KEY=                       # کلید همان provider (برای ollama محلی لازم نیست)
LLM_BASE_URL=                      # برای endpoint سازگار با OpenAI (vLLM/LM Studio/Azure)
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=45
# سازگاری با ابزارهایی که OPENAI_API_KEY می‌خوانند
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── کانال تأیید واقعی (اختیاری) ──────────────────────────────────────────────
# تا وقتی این‌ها تنظیم نشوند، همه درخواست‌های تأیید «نمایشی» برچسب می‌خورند و
# هیچ تماس/پیامی ارسال نمی‌شود. این رفتار عمدی و اخلاقی است.
TELEPHONY_PROVIDER=none            # none | twilio | vonage
TELEPHONY_API_KEY=
TELEPHONY_FROM_NUMBER=

# ── جست‌وجو ──────────────────────────────────────────────────────────────────
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100
STORE_SEARCH_RADIUS_KM_DEFAULT=5
STORE_SEARCH_RADIUS_KM_MAX=50
