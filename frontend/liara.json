{
  "app": "torob-web",
  "platform": "docker",
  "port": 3000,
  "build": { "location": "iran" },
  "healthCheck": {
    "command": "CMD curl --fail http://localhost:3000/ || exit 1",
    "interval": 30,
    "timeout": 15,
    "retries": 3,
    "startPeriod": 25
  },
  "envs": {
    "BACKEND_INTERNAL_URL": "http://torob-api:8000",
    "PORT": "3000"
  }
}
